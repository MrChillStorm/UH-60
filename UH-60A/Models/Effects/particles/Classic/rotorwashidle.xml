<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <particlesystem>

    <name>rotorwashidle</name>
    <texture>smoke.png</texture>

    <emissive>false</emissive>
    <lighting>false</lighting>

    <attach>world</attach>

    <placer>
      <type>point</type>
    </placer>

    <condition>
      <!-- <not><property>sim/freeze/clock</property></not> -->
      <not><property>sim/multiplay/generic/bool[5]</property></not>
      <!-- <not><property>sim/crashed</property></not> -->
      <not><property>sim/multiplay/generic/bool[6]</property></not>
      <less-than>
        <!-- <property>position/altitude-agl-ft</property> -->
        <property>sim/multiplay/generic/float[0]</property>
        <value>70</value>
      </less-than>
      <greater-than>
        <property>rotors/main/rpm</property>
        <value>60</value>
      </greater-than>
    </condition>

    <shooter>
      <theta-min-deg>   0.0 </theta-min-deg>
      <theta-max-deg> 360.0 </theta-max-deg>
      <phi-min-deg>    -0.1 </phi-min-deg>
      <phi-max-deg>     0.1 </phi-max-deg>
      <speed-mps>
        <property>rotors/main/rpm</property>
        <factor> 0.1 </factor>
        <spread> 2.0 </spread>
      </speed-mps>
      <rotation-speed>
        <x-max-deg-sec>  15 </x-max-deg-sec>
        <x-min-deg-sec> -15 </x-min-deg-sec>
        <y-max-deg-sec>  15 </y-max-deg-sec>
        <y-min-deg-sec> -15 </y-min-deg-sec>
        <z-max-deg-sec>  15 </z-max-deg-sec>
        <z-min-deg-sec> -15 </z-min-deg-sec>
      </rotation-speed>
    </shooter>

    <counter>
      <particles-per-sec>
        <!-- <property>position/altitude-agl-ft</property> -->
        <property>sim/multiplay/generic/float[0]</property>
        <factor>    -40 </factor>
        <offset-m> 2000 </offset-m>
      </particles-per-sec>
    </counter>

    <align>billboard</align>

    <particle>
      <start>
        <color>
          <red>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/redcombinedstart</property> -->
            <property>sim/multiplay/generic/float[3]</property>
          </red>
          <green>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/greencombinedstart</property> -->
            <property>sim/multiplay/generic/float[4]</property>
          </green>
          <blue>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/bluecombinedstart</property> -->
            <property>sim/multiplay/generic/float[5]</property>
          </blue>
          <alpha>
            <property>rotors/main/rpm</property>
            <factor>0.00009</factor>
          </alpha>
        </color>
        <size>
          <value> 1</value>
          <spread>0.5</spread>
        </size>
      </start>

      <end>
        <color>
          <red>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/redcombinedend</property> -->
            <property>sim/multiplay/generic/float[6]</property>
          </red>
          <green>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/greencombinedend</property> -->
            <property>sim/multiplay/generic/float[7]</property>
          </green>
          <blue>
            <!-- <property>sim/model/uh60/effects/particles/rotorwash/bluecombinedend</property> -->
            <property>sim/multiplay/generic/float[8]</property>
          </blue>
          <alpha>
            <property>rotors/main/rpm</property>
            <factor>0.0007</factor>
          </alpha>
        </color>
        <size>
          <value>  0.4 </value>
          <spread> 0.4 </spread>
        </size>
      </end>

      <life-sec>
        <value>2</value>
      </life-sec>
      <mass-kg>  0.01 </mass-kg>
      <radius-m> 0.01 </radius-m>
    </particle>

    <program>
      <fluid>     air </fluid>
      <gravity> false </gravity>
      <wind>     true </wind>
    </program>

  </particlesystem>

  <!-- pitch -->
  <animation>
    <type>rotate</type>
    <object-name>rotorwashidle</object-name>
    <!-- <property>orientation/pitch-deg</property> -->
    <property>sim/multiplay/generic/float[2]</property>
    <factor> 1 </factor>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <!-- roll -->
  <animation>
    <type>rotate</type>
    <object-name>rotorwashidle</object-name>
    <!-- <property>orientation/roll-deg</property> -->
    <property>sim/multiplay/generic/float[1]</property>
    <factor> 1 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!--Translate to ground level  -->
  <animation>
    <type>translate</type>
    <object-name>rotorwashidle</object-name>
    <!-- <property>position/altitude-agl-ft</property> -->
    <property>sim/multiplay/generic/float[0]</property>
    <factor> -0.3048 </factor>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
