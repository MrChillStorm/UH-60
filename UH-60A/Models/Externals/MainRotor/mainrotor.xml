<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- The main rotor, written by fdm/rotorvis.py (see there): the hub at the flight model's
     rotor azimuth, blade k on FlightGear's rotors/main/blade[k] -->

<PropertyList>

  <path>mainrotor.ac</path>

  <animation>
    <object-name>chapeau</object-name>
    <object-name>rotor</object-name>
    <object-name>assemble</object-name>
    <object-name>plateau</object-name>
    <object-name>pistons</object-name>
    <object-name>axeH</object-name>
    <object-name>axeV</object-name>
  </animation>

  <model>
    <name>Blade1</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <lag>rotors/main/blade[0]/lag-deg</lag>
        <flap>rotors/main/blade[0]/flap-deg</flap>
        <pitch>rotors/main/blade[0]/pitch-deg</pitch>
      </params>
    </overlay>
  </model>

  <model>
    <name>Blade2</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <lag>rotors/main/blade[1]/lag-deg</lag>
        <flap>rotors/main/blade[1]/flap-deg</flap>
        <pitch>rotors/main/blade[1]/pitch-deg</pitch>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 90 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>Blade3</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <lag>rotors/main/blade[2]/lag-deg</lag>
        <flap>rotors/main/blade[2]/flap-deg</flap>
        <pitch>rotors/main/blade[2]/pitch-deg</pitch>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 180 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>Blade4</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <lag>rotors/main/blade[3]/lag-deg</lag>
        <flap>rotors/main/blade[3]/flap-deg</flap>
        <pitch>rotors/main/blade[3]/pitch-deg</pitch>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 270 </heading-deg>
    </offsets>
  </model>

  <animation>
    <name>rotorcomplet</name>
    <object-name>chapeau</object-name>
    <object-name>assemble</object-name>
    <object-name>plateau</object-name>
    <object-name>pistons</object-name>
    <object-name>axeH</object-name>
    <object-name>axeV</object-name>
    <object-name>Blade1</object-name>
    <object-name>Blade2</object-name>
    <object-name>Blade3</object-name>
    <object-name>Blade4</object-name>
  </animation>

  <!-- the hub at blade 0's azimuth: anticlockwise from above, from the tail -->
  <animation>
    <type>rotate</type>
    <object-name>rotorcomplet</object-name>
    <property>rotors/main/blade[0]/position-deg</property>
    <center>
      <x-m> 0.00000 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.00000 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

</PropertyList>
