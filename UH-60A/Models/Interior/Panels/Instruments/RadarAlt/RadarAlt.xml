<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>RadarAlt.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>marker</object-name>
    <object-name>needle</object-name>
    <object-name>Alarm</object-name>
    <object-name>knob</object-name>
    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>face</object-name>
    <object-name>marker</object-name>
    <object-name>needle</object-name>
    <object-name>Alarm</object-name>
    <object-name>knob</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../../../../Effects/Glass/glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>fond</object-name>
    <object-name>needle</object-name>
    <object-name>marker</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <!-- height of the wheels (flight model): the aircraft's reference point stands about 6 ft up -->
    <property>/sim/model/uh60/radar-alt-ft</property>
    <interpolation>
      <entry><ind> -9999 </ind><dep>    0 </dep></entry>
      <entry><ind>     0 </ind><dep>    0 </dep></entry>
      <entry><ind>   500 </ind><dep> -160 </dep></entry>
      <entry><ind>  1000 </ind><dep> -180 </dep></entry>
      <entry><ind>  1500 </ind><dep> -200 </dep></entry>
      <entry><ind>  2000 </ind><dep> -220 </dep></entry>
      <entry><ind>  2500 </ind><dep> -240 </dep></entry>
      <entry><ind>  3000 </ind><dep> -260 </dep></entry>
      <entry><ind> 30000 </ind><dep> -260 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

 <animation>
   <type>pick</type>
   <object-name>knob</object-name>
   <visible>true</visible>
   <action>
     <name>up</name>
     <button>3</button>
     <repeatable>false</repeatable>
     <binding>
       <command>property-adjust</command>
       <property>/instrumentation/radar-altimeter/decision-height</property>
       <step>  10 </step>
       <min>    0 </min>
       <max> 2500 </max>
       <wrap>false</wrap>
     </binding>
   </action>
   <action>
     <name>down</name>
     <button>4</button>
     <repeatable>false</repeatable>
     <binding>
       <command>property-adjust</command>
       <property>/instrumentation/radar-altimeter/decision-height</property>
       <step> -10 </step>
       <min>    0 </min>
       <max> 2500 </max>
       <wrap>false</wrap>
     </binding>
   </action>
 </animation>

  <animation>
    <type>rotate</type>
    <object-name>marker</object-name>
    <property>/instrumentation/radar-altimeter/decision-height</property>
    <interpolation>
      <entry><ind>    0 </ind><dep>    0 </dep></entry>
      <entry><ind>  500 </ind><dep> -160 </dep></entry>
      <entry><ind> 1000 </ind><dep> -180 </dep></entry>
      <entry><ind> 1500 </ind><dep> -200 </dep></entry>
      <entry><ind> 2000 </ind><dep> -220 </dep></entry>
      <entry><ind> 2500 </ind><dep> -240 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Label Text -->
  <text>
    <name>LabelText</name>
    <type type="string">literal</type>
    <text type="string">Radar Altimeter</text>
    <draw-text type="bool">true</draw-text>
    <font>Helvetica.txf</font>
    <character-size type="double">0.012</character-size>
    <character-aspect-ratio type="double">1.0</character-aspect-ratio>
    <axis-alignment>yz-plane</axis-alignment>
    <max-height>0.2</max-height>
    <max-width>0.07</max-width>
    <font-resolution>
      <width type="int">32</width>
      <height type="int">32</height>
    </font-resolution>
    <alignment>center-center</alignment>
    <offsets>
      <x-m> 0.01</x-m>
      <y-m> 0.0 </y-m>
      <z-m> 0.0 </z-m>
    </offsets>
  </text>

  <animation>
    <type>material</type>
    <object-name>LabelText</object-name>
    <emission>
      <red>   1.0 </red>
      <green> 0.8 </green>
      <blue>  0.0 </blue>
    </emission>
  </animation>

  <animation>
    <type>select</type>
    <object-name>LabelText</object-name>
    <condition>
      <property>sim/panel-hotspots</property>
    </condition>
  </animation>

</PropertyList>
