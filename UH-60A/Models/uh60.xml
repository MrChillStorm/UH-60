  <!-- Probe -->
  <animation>
    <type>select</type>
    <object-name>probe</object-name>
    <condition>
      <!-- <property>sim/model/show-probe</property> -->
      <property>sim/multiplay/generic/bool[7]</property>
    </condition>
  </animation>

  <!-- Wings -->
  <animation>
    <type>select</type>
    <object-name>wings</object-name>
