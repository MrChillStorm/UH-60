  </animation>

  <animation>
    <type>rotate</type>
    <object-name>hour</object-name>
    <property>/sim/time/local-day-seconds</property>
    <factor> 0.00833333 </factor>
    <center>
      <x-m> 0.0000 </x-m>
      <y-m> 0.0000 </y-m>
      <z-m> 0.0000 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>minute</object-name>
    <property>/sim/time/local-day-seconds</property>
    <factor> 0.1 </factor>
    <center>
      <x-m> 0.0000 </x-m>
      <y-m> 0.0000 </y-m>
      <z-m> 0.0000 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>second</object-name>
    <property>/sim/time/local-day-seconds</property>
    <factor> 6 </factor>
    <center>
      <x-m> 0.0000 </x-m>
      <y-m> 0.0000 </y-m>
      <z-m> 0.0000 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
