<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <light>
    <name>strobeLlight</name>
    <!-- HDR: a spot aimed out through its lens, so that it lights the night around it and not its own skin;
         intensity in candela, converted with the sun (fdm/cockpit/instruments.py, HDR_CD) -->
    <type>spot</type>
    <direction>
      <lookat-x-m> 0 </lookat-x-m>
      <lookat-y-m> 0 </lookat-y-m>
      <lookat-z-m> 1 </lookat-z-m>
    </direction>
    <color>
      <r> 1 </r>
      <g> 1 </g>
      <b> 1 </b>
    </color>
    <intensity>
      <property>/instrumentation/uh60/lights/hdr/unit-per-cd</property>
      <scale> 400 </scale>                     <!-- cd -->
    </intensity>
    <spot-exponent> 1 </spot-exponent>
    <spot-cutoff> 80 </spot-cutoff>
    <range-m> 40 </range-m>
  </light>

  <animation>
    <type>noshadow</type>
    <object-name>strobeLlight</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>strobeLlight</object-name>
    <nopreview/>
    <condition>
      <!-- <property>controls/lighting/strobe</property> -->
      <property>sim/multiplay/generic/bool[13]</property>
      <!-- <property>sim/model/lights/sbc1/state</property> -->
      <property>sim/multiplay/generic/bool[14]</property>
    </condition>
  </animation>

</PropertyList>
