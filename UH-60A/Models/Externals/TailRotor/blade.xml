<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- One tail rotor blade, written by fdm/rotorvis.py (see there); tailrotor.xml gives each
     instance its blade's flap in params -->

<PropertyList>

  <path>blade-rotor.ac</path>

  <params>
    <flap>rotors/tail/blade[0]/flap-deg</flap>
  </params>

  <!-- the livery's paint: the blade, with or without tip stripes -->
  <animation>
    <type>pbr</type>
    <object-name>blade</object-name>
    <object-name>tblade</object-name>
    <property-base>sim/model/livery/blades</property-base>
    <base-color-texture-prop>tail</base-color-texture-prop>
  </animation>
  <animation>
    <type>material</type>
    <object-name>blade</object-name>
    <object-name>tblade</object-name>
    <property-base>sim/model/livery/blades</property-base>
    <texture-prop>tail</texture-prop>
    <texture>tailblade.png</texture>
  </animation>

