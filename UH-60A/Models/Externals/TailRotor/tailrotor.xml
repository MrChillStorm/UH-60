<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- The tail rotor, written by fdm/rotorvis.py (see there): the hub at the flight model's
     tail rotor azimuth -->

<PropertyList>

  <path>tailrotor.ac</path>

  <animation>
    <object-name>rotortail</object-name>
  </animation>

  <model>
    <name>Blade1</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <flap>rotors/tail/blade[0]/flap-deg</flap>
      </params>
    </overlay>
  </model>

  <model>
    <name>Blade2</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <flap>rotors/tail/blade[1]/flap-deg</flap>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 90 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>Blade3</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <flap>rotors/tail/blade[2]/flap-deg</flap>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 180 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>Blade4</name>
    <path>blade.xml</path>
    <overlay>
      <params>
        <flap>rotors/tail/blade[3]/flap-deg</flap>
      </params>
    </overlay>
    <offsets>
      <heading-deg> 270 </heading-deg>
    </offsets>
  </model>

  <animation>
    <name>rotorcomplet</name>
    <object-name>rotortail</object-name>
    <object-name>Blade1</object-name>
    <object-name>Blade2</object-name>
    <object-name>Blade3</object-name>
    <object-name>Blade4</object-name>
  </animation>

  <!-- the hub at blade 0's azimuth -->
  <animation>
    <type>rotate</type>
    <object-name>rotorcomplet</object-name>
    <property>rotors/tail/blade[0]/position-deg</property>
    <center>
      <x-m> 0.00000 </x-m>
      <y-m> 0.00000 </y-m>
      <z-m> 0.00000 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

</PropertyList>
