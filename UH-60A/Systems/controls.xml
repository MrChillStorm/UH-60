<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <lighting>
    <instrument-lights type="bool">false</instrument-lights>
    <nav-lights        type="bool">false</nav-lights>
    <taxi-lights       type="bool">false</taxi-lights>
    <beacon            type="bool">false</beacon>
    <strobe            type="bool">false</strobe>
    <landing-lights    type="bool">false</landing-lights>
    <luminosite-lights type="float">1</luminosite-lights>
    <floods-lights     type="float">1</floods-lights>
    <elt               type="bool">false</elt>
  </lighting>

  <electric>
    <battery-switch    type="bool">false</battery-switch>
    <fan               type="bool">false</fan>
    <generator         type="int">0</generator>
    <alimentation>
      <deice           type="int">0</deice>
    </alimentation>
    <engine          n="0">
      <fuel-pump     type="bool">false</fuel-pump>
    </engine>
    <engine          n="1">
      <fuel-pump     type="bool">false</fuel-pump>
    </engine>
  </electric>

  <!-- collective: engine[0] throttle, 0 = full down, 1 = full up. ENG POWER CONT levers: mixture, 0 OFF, 0.5 IDLE, 1 FLY -->
  <engines>
    <ignition          type="bool">true</ignition>
    <engine            n="0">
      <throttle        type="double">0</throttle>
      <mixture         type="double">1</mixture>
      <np-trim         type="double">0</np-trim>
    </engine>
    <engine            n="1">
      <throttle        type="double">0</throttle>
      <mixture         type="double">1</mixture>
      <np-trim         type="double">0</np-trim>
    </engine>
  </engines>

  <rotor>
    <brake             type="double">0</brake>
  </rotor>

  <fuel>
    <crossfeed         type="bool">false</crossfeed>
  </fuel>

  <gear>
    <brake-parking     type="bool">true</brake-parking>
    <emergency         type="bool">false</emergency>
    <tailwheel-lock    type="bool">true</tailwheel-lock>
  </gear>

  <flight>
    <rudder-trim       type="double"> 0.00 </rudder-trim>
    <aileron-trim      type="double"> 0.00 </aileron-trim>
    <elevator-trim     type="double"> 0.00 </elevator-trim>
  </flight>

</PropertyList>
