<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- UH-60A cockpit lights (TM 1-1520-237-10 2.70.2-2.70.4): the INSTR LT, LIGHTED SWITCHES and GLARESHIELD LIGHTS
     rheostats of the upper console and the cockpit floodlights' switch; Nasal/avionics.nas lights the cockpit from
     them -->
<PropertyList>

  <name>lights</name>
  <modal>false</modal>
  <layout>vbox</layout>

  <group>
    <layout>hbox</layout>
    <empty><stretch>1</stretch></empty>
    <text>
      <label>Cockpit lights</label>
    </text>
    <empty><stretch>1</stretch></empty>
    <button>
      <pref-width>16</pref-width>
      <pref-height>16</pref-height>
      <legend></legend>
      <keynum>27</keynum>
      <border>2</border>
      <binding>
        <command>dialog-close</command>
      </binding>
    </button>
  </group>

  <hrule/>

  <group>
    <layout>table</layout>

    <text>
      <row>0</row><col>0</col>
      <halign>left</halign>
      <label>INSTR LT PILOT FLT</label>
    </text>
    <text><row>0</row><col>1</col><label>OFF</label></text>
    <slider>
      <row>0</row><col>2</col>
      <name>plt-flt</name>
      <pref-width>160</pref-width>
      <min>0</min>
      <max>1</max>
      <step>0.05</step>
      <live>true</live>
      <property>/controls/lighting/instr-plt-flt</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>plt-flt</object-name>
      </binding>
    </slider>
    <text><row>0</row><col>3</col><label>BRT</label></text>

    <text>
      <row>1</row><col>0</col>
      <halign>left</halign>
      <label>CPLT FLT INST LTS</label>
    </text>
    <text><row>1</row><col>1</col><label>OFF</label></text>
    <slider>
      <row>1</row><col>2</col>
      <name>cplt-flt</name>
      <pref-width>160</pref-width>
      <min>0</min>
      <max>1</max>
      <step>0.05</step>
      <live>true</live>
      <property>/controls/lighting/instr-cplt-flt</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>cplt-flt</object-name>
      </binding>
    </slider>
    <text><row>1</row><col>3</col><label>BRT</label></text>

    <text>
      <row>2</row><col>0</col>
      <halign>left</halign>
      <label>INSTR LT NON FLT</label>
    </text>
    <text><row>2</row><col>1</col><label>OFF</label></text>
    <slider>
      <row>2</row><col>2</col>
      <name>non-flt</name>
      <pref-width>160</pref-width>
      <min>0</min>
      <max>1</max>
      <step>0.05</step>
      <live>true</live>
      <property>/controls/lighting/instr-non-flt</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>non-flt</object-name>
      </binding>
    </slider>
    <text><row>2</row><col>3</col><label>BRT</label></text>

    <text>
      <row>3</row><col>0</col>
      <halign>left</halign>
      <label>LIGHTED SWITCHES</label>
    </text>
    <text><row>3</row><col>1</col><label>DIM</label></text>
    <slider>
      <row>3</row><col>2</col>
      <name>switches</name>
      <pref-width>160</pref-width>
      <min>0</min>
      <max>1</max>
      <step>0.05</step>
      <live>true</live>
      <property>/controls/lighting/lighted-switches</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>switches</object-name>
      </binding>
    </slider>
    <text><row>3</row><col>3</col><label>BRT</label></text>

    <text>
      <row>4</row><col>0</col>
      <halign>left</halign>
      <label>GLARESHIELD LIGHTS</label>
    </text>
    <text><row>4</row><col>1</col><label>OFF</label></text>
    <slider>
      <row>4</row><col>2</col>
      <name>glareshield</name>
      <pref-width>160</pref-width>
      <min>0</min>
      <max>1</max>
      <step>0.05</step>
      <live>true</live>
      <property>/controls/lighting/glareshield</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>glareshield</object-name>
      </binding>
    </slider>
    <text><row>4</row><col>3</col><label>BRT</label></text>
  </group>

  <group>
    <layout>hbox</layout>
    <text>
      <label>COCKPIT FLOOD</label>
    </text>
    <button>
      <legend>BLUE</legend>
      <binding>
        <command>property-assign</command>
        <property>/controls/lighting/cockpit-flood</property>
        <value>1</value>
      </binding>
    </button>
    <button>
      <legend>OFF</legend>
      <binding>
        <command>property-assign</command>
        <property>/controls/lighting/cockpit-flood</property>
        <value>0</value>
      </binding>
    </button>
    <button>
      <legend>WHITE</legend>
      <binding>
        <command>property-assign</command>
        <property>/controls/lighting/cockpit-flood</property>
        <value>-1</value>
      </binding>
    </button>
  </group>

  <group>
    <layout>hbox</layout>
    <button>
      <legend>Caution/advisory BRT/DIM</legend>
      <binding>
        <command>nasal</command>
        <script>avionics.brt_dim()</script>
      </binding>
    </button>
    <text>
      <label>MMMM</label>
      <format>%s</format>
      <property>/instrumentation/uh60/lights/cap-mode</property>
      <live>true</live>
    </text>
  </group>

  <hrule/>

  <text>
    <halign>left</halign>
    <label>The lights need ac power: the generators, on line above 93.75 % rotor speed.</label>
  </text>
  <text>
    <halign>left</halign>
    <label>RAD ALT DIMMING, MA WRN and CAUT/ADVSY dimmers are on the instrument panel.</label>
  </text>
  <text>
    <halign>left</halign>
    <label>BRT/DIM (also: right click the caution/advisory panel's BRT/DIM-TEST switch) needs PILOT FLT on.</label>
  </text>
  <text>
    <halign>left</halign>
    <label>Dim, the dimmers set the warning and caution lights and the lighted switches; bright, they're full.</label>
  </text>
  <text>
    <halign>left</halign>
    <label>The glareshield lights and cockpit floods show in the HDR renderer only.</label>
  </text>

</PropertyList>
