<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- pilot display unit: % RPM 1 / R / 2 (power turbine speeds Np and the rotor) and % TRQ of each engine,
     calibrated to the printed scale marks -->
<PropertyList>

  <path>prop-rpm.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpm1</object-name>
    <property>engines/engine[0]/n2-pct</property>
    <interpolation>
      <entry><ind>     0 </ind><dep> 0.0015 </dep></entry>
      <entry><ind>    50 </ind><dep> 0.0164 </dep></entry>
      <entry><ind>    70 </ind><dep> 0.0460 </dep></entry>
      <entry><ind>    90 </ind><dep> 0.0757 </dep></entry>
      <entry><ind>    95 </ind><dep> 0.1053 </dep></entry>
      <entry><ind>   100 </ind><dep> 0.1350 </dep></entry>
      <entry><ind>   105 </ind><dep> 0.1646 </dep></entry>
      <entry><ind>   110 </ind><dep> 0.1943 </dep></entry>
      <entry><ind>   120 </ind><dep> 0.2239 </dep></entry>
      <entry><ind>   130 </ind><dep> 0.2499 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpm2</object-name>
    <property>engines/engine[1]/n2-pct</property>
    <interpolation>
      <entry><ind>     0 </ind><dep> 0.0015 </dep></entry>
      <entry><ind>    50 </ind><dep> 0.0166 </dep></entry>
      <entry><ind>    70 </ind><dep> 0.0467 </dep></entry>
      <entry><ind>    90 </ind><dep> 0.0768 </dep></entry>
      <entry><ind>    95 </ind><dep> 0.1069 </dep></entry>
      <entry><ind>   100 </ind><dep> 0.1370 </dep></entry>
      <entry><ind>   105 </ind><dep> 0.1671 </dep></entry>
      <entry><ind>   110 </ind><dep> 0.1972 </dep></entry>
      <entry><ind>   120 </ind><dep> 0.2273 </dep></entry>
      <entry><ind>   130 </ind><dep> 0.2537 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpmR</object-name>
    <property>rotors/main/rpm-pct</property>
    <interpolation>
      <entry><ind>     0 </ind><dep> 0.0014 </dep></entry>
      <entry><ind>    50 </ind><dep> 0.0163 </dep></entry>
      <entry><ind>    70 </ind><dep> 0.0462 </dep></entry>
      <entry><ind>    90 </ind><dep> 0.0760 </dep></entry>
      <entry><ind>    95 </ind><dep> 0.1058 </dep></entry>
      <entry><ind>   100 </ind><dep> 0.1357 </dep></entry>
      <entry><ind>   105 </ind><dep> 0.1655 </dep></entry>
      <entry><ind>   110 </ind><dep> 0.1953 </dep></entry>
      <entry><ind>   120 </ind><dep> 0.2252 </dep></entry>
      <entry><ind>   130 </ind><dep> 0.2513 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>trq1</object-name>
    <property>engines/engine[0]/torque-pct</property>
    <interpolation>
      <entry><ind>     0 </ind><dep> 0.0027 </dep></entry>
      <entry><ind>    20 </ind><dep> 0.0384 </dep></entry>
      <entry><ind>    40 </ind><dep> 0.0735 </dep></entry>
      <entry><ind>    60 </ind><dep> 0.1086 </dep></entry>
      <entry><ind>    80 </ind><dep> 0.1436 </dep></entry>
      <entry><ind>   100 </ind><dep> 0.1787 </dep></entry>
      <entry><ind>   120 </ind><dep> 0.2138 </dep></entry>
      <entry><ind>   140 </ind><dep> 0.2489 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>trq2</object-name>
    <property>engines/engine[1]/torque-pct</property>
    <interpolation>
      <entry><ind>     0 </ind><dep> 0.0031 </dep></entry>
      <entry><ind>    20 </ind><dep> 0.0412 </dep></entry>
      <entry><ind>    40 </ind><dep> 0.0787 </dep></entry>
      <entry><ind>    60 </ind><dep> 0.1162 </dep></entry>
      <entry><ind>    80 </ind><dep> 0.1538 </dep></entry>
      <entry><ind>   100 </ind><dep> 0.1913 </dep></entry>
      <entry><ind>   120 </ind><dep> 0.2288 </dep></entry>
      <entry><ind>   140 </ind><dep> 0.2663 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- DIGIT -->
  <animation>
    <type>textranslate</type>
    <object-name>digit10L</object-name>
    <property>engines/engine[0]/torque-pct</property>
    <factor>0.01</factor>
    <step>10</step>
    <min>0</min>
    <bias></bias>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit1L</object-name>
    <property>engines/engine[0]/torque-pct</property>
    <factor>0.1</factor>
    <step>1</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit10R</object-name>
    <property>engines/engine[1]/torque-pct</property>
    <factor>0.01</factor>
    <step>10</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit1R</object-name>
    <property>engines/engine[1]/torque-pct</property>
    <factor>0.1</factor>
    <step>1</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
