    <inherits-from>../../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <rotor-rpm type="float"><use>/rotors/tail/rpm</use></rotor-rpm>
      <fade-from type="float"> 92.2481 </fade-from>
      <fade-to type="float"> 737.984 </fade-to>
      <pbr-roughness type="float"> 1 </pbr-roughness>
      <shadow-gain type="float"> 2 </shadow-gain>
    </parameters>
    <object-name>blur0</object-name>
    <object-name>blur1</object-name>
    <object-name>blur2</object-name>
    <object-name>blur3</object-name>
    <object-name>blur4</object-name>
    <object-name>blur5</object-name>
    <object-name>blur6</object-name>
    <object-name>blur7</object-name>
    <object-name>blur8</object-name>
