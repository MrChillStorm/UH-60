<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <sim                            include="views.xml">

    <fuel-fraction>1</fuel-fraction>

    <startup>
      <splash-texture>Aircraft/UH-60A/uh60-splash.png</splash-texture>
    </startup>

    <sound>
      <path>Aircraft/UH-60A/Sounds/uh60-sound.xml</path>
    </sound>

    <model>
      <path                       archive="y">Aircraft/UH-60A/Models/uh60.xml</path>
      <livery>
        <file                     type="string"/>
        <specular>
          <red                    type="float"> 0.03 </red>
          <green                  type="float"> 0.03 </green>
          <blue                   type="float"> 0.03 </blue>
        </specular>
      </livery>
      <show-noze                  type="bool"/>
      <show-grue                  type="bool"/>
      <show-probe                 type="bool"/>
      <show-wings                 type="bool"/>
      <show-copilot               type="bool"/>
      <uh60>
        <state                    type="int">0</state>
        <engine                   type="float">0</engine>
        <rotor-step-deg           type="float">-1</rotor-step-deg>
        <effects>
          <particles>
            <rotorwash>
              <redcombinedstart   type="float">0.3</redcombinedstart>
              <greencombinedstart type="float">0.3</greencombinedstart>
              <bluecombinedstart  type="float">.3</bluecombinedstart>
              <redcombinedend     type="float">0.5</redcombinedend>
              <greencombinedend   type="float">0.5</greencombinedend>
              <bluecombinedend    type="float">0.5</bluecombinedend>
            </rotorwash>
            <enabled              type="bool">true</enabled>
            <redcombined          type="float">0</redcombined>
            <greencombined        type="float">0</greencombined>
            <bluecombined         type="float">0</bluecombined>
          </particles>
        </effects>
      </uh60>
    </model>

    <systems                      include="rules.xml"/>

    <instrumentation              include="initialisation.xml"/>

    <multiplay>
      <chat_display>1</chat_display>
      <generic>
        <!-- Immat -->
        <int    n="0"  type="int">0</int>
        <int    n="1"  type="int">0</int>
        <int    n="2"  type="int">0</int>
        <int    n="3"  type="int">0</int>
        <int    n="4"  type="int">0</int>
        <int    n="5"  type="int">0</int>
        <!-- -->
        <int    n="6"  type="int" alias="/sim/model/uh60/state"/>
        <!-- -->
        <bool   n="0"  alias="/sim/model/show-noze"/>
        <bool   n="1"  alias="/sim/model/show-grue"/>
        <bool   n="2"  alias="/sim/rendering/hdr/hdr-enabled"/>
        <bool   n="5"  alias="/sim/freeze/clock"/>
        <bool   n="6"  alias="/sim/crashed"/>
        <bool   n="7"  alias="/sim/model/show-probe"/>
        <bool   n="8"  alias="/sim/model/show-wings"/>
        <bool   n="9"  alias="/sim/model/show-copilot"/>
        <!-- Lights -->
        <bool   n="11" alias="/controls/lighting/beacon"/>
        <bool   n="12" alias="/sim/model/lights/beacon/state"/>
        <bool   n="13" alias="/controls/lighting/strobe"/>
        <bool   n="14" alias="/sim/model/lights/sbc1/state"/>
        <bool   n="15" alias="/controls/lighting/nav-lights"/>
        <bool   n="16" alias="/controls/lighting/landing-lights"/>
        <!-- -->
        <bool   n="17" alias="/gear/gear[0]/wow"/>
        <bool   n="18" alias="/gear/gear[1]/wow"/>
        <bool   n="19" alias="/gear/gear[2]/wow"/>
        <!-- -->
        <float  n="0"  alias="/position/altitude-agl-ft"/>
        <float  n="1"  alias="/orientation/roll-deg"/>
        <float  n="2"  alias="/orientation/pitch-deg"/>
        <!-- -->
        <float  n="3"  alias="/sim/model/uh60/effects/particles/rotorwash/redcombinedstart"/>
        <float  n="4"  alias="/sim/model/uh60/effects/particles/rotorwash/greencombinedstart"/>
        <float  n="5"  alias="/sim/model/uh60/effects/particles/rotorwash/bluecombinedstart"/>
        <float  n="6"  alias="/sim/model/uh60/effects/particles/rotorwash/redcombinedend"/>
        <float  n="7"  alias="/sim/model/uh60/effects/particles/rotorwash/greencombinedend"/>
        <float  n="8"  alias="/sim/model/uh60/effects/particles/rotorwash/bluecombinedend"/>
        <!-- Doors -->
        <float  n="9"  alias="/sim/model/door-positions/crew/position-norm"/>
        <float  n="10" alias="/sim/model/door-positions/passenger/position-norm"/>
        <float  n="11" alias="/sim/model/door-positions/windowsL/position-norm"/>
        <float  n="12" alias="/sim/model/door-positions/windowsR/position-norm"/>
        <float  n="13" alias="/sim/model/door-positions/bayL/position-norm"/>
        <float  n="14" alias="/sim/model/door-positions/bayR/position-norm"/>
        <!-- Engine -->
        <float  n="15" alias="/controls/engines/engine/throttle"/>
        <!-- Ground -->
        <float  n="16" alias="/gear/gear[0]/rollspeed-ms"/>
        <float  n="17" alias="/gear/gear[1]/rollspeed-ms"/>
        <float  n="18" alias="/gear/gear[2]/rollspeed-ms"/>
        <!-- -->
        <float  n="19" alias="/rotors/gear[0]/torque-sound-filtered"/>
        <!-- -->
        <float  n="20" alias="/rotors/main/cone1-deg"/>
        <float  n="21" alias="/rotors/main/cone2-deg"/>
        <float  n="22" alias="/rotors/main/cone3-deg"/>
        <float  n="23" alias="/rotors/main/cone4-deg"/>
        <float  n="24" alias="/rotors/main/blade[0]/incidence-deg"/>
        <float  n="25"  alias="/rotors/tail/blade[0]/incidence-deg"/>
        <!-- -->
        <float  n="26" alias="/gear/gear[2]/caster-angle-deg"/>
        <!-- -->
        <float  n="27" alias="/gear/gear[0]/compression-norm"/>
        <float  n="28" alias="/gear/gear[1]/compression-norm"/>
        <!-- -->
        <float  n="29" alias="/rotors/main/roll-deg"/>
        <float  n="30" alias="/rotors/main/yaw-deg"/>
        <!-- -->
        <string n="0"  alias="/sim/model/mode"/>
        <!-- -->
        <string n="1"  alias="/sim/model/livery/texture"/>
        <!-- For Bombable -->
        <int    n="10" type="int" alias="controls/armament/trigger">0</int>
        <string n="9"  type="string"/>
      </generic>
    </multiplay>

    <!-- point masses of the JSBSim model (fdm/genuh60.py POINT_MASSES), in the same order -->
    <weight                       n="0">
      <name                       type="string">Pilot (right seat)</name>
      <weight-lb                  alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[0]"/>
      <max-lb                     type="double">300</max-lb>
    </weight>
    <weight                       n="1">
      <name                       type="string">Copilot (left seat)</name>
      <weight-lb                  alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[1]"/>
      <max-lb                     type="double">300</max-lb>
    </weight>
    <weight                       n="2">
      <name                       type="string">Crew chief and gunner</name>
      <weight-lb                  alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[2]"/>
      <max-lb                     type="double">600</max-lb>
    </weight>
    <weight                       n="3">
      <name                       type="string">Cabin load (troops, cargo)</name>
      <weight-lb                  alias="/fdm/jsbsim/inertia/pointmass-weight-lbs[3]"/>
      <max-lb                     type="double">2640</max-lb>
    </weight>

    <help                         include="help.xml"/>

    <menubar                      include="../Dialogs/uh60-menu.xml"/>

    <aircraft-data                include="aircraft-data.xml"/>

  </sim>

  <!-- fuel: two 180 US gal main cells (JP-8); the FDM burns #1 from tank 0 and #2 from tank 1 -->
  <consumables>
    <fuel>
      <tank n="0">
        <name type="string">Left main cell (No. 1 engine)</name>
        <density-ppg type="double">6.7</density-ppg>
        <capacity-gal_us type="double">180</capacity-gal_us>
        <unusable-gal_us type="double">2</unusable-gal_us>
        <level-lbs type="double">1206</level-lbs>
      </tank>
      <tank n="1">
        <name type="string">Right main cell (No. 2 engine)</name>
        <density-ppg type="double">6.7</density-ppg>
        <capacity-gal_us type="double">180</capacity-gal_us>
        <unusable-gal_us type="double">2</unusable-gal_us>
        <level-lbs type="double">1206</level-lbs>
      </tank>
    </fuel>
  </consumables>

  <fdm>
    <jsbsim>
      <eng>
        <init-running             type="int">0</init-running>
      </eng>
    </jsbsim>
  </fdm>

  <constants>
    <zero                         type="int">0</zero>
    <un                           type="int">1</un>
  </constants>

  <input                          include="uh60-keyboard.xml"/>

  <controls                       include="controls.xml"/>

  <rotors                         include="rotors.xml"/>

  <engines                        include="engines.xml"/>

  <instrumentation                include="instrumentation.xml">
    <gsdi>
      <serviceable                type="bool">true</serviceable>
      <enabled                    type="bool">true</enabled>
    </gsdi>
  </instrumentation>

  <nasal>
    <rotorwash>
      <file>Aircraft/UH-60A/Nasal/rotorwash.nas</file>
    </rotorwash>
    <doors>
      <file>Aircraft/UH-60A/Nasal/doors.nas</file>
    </doors>
    <uh60>
      <file>Aircraft/UH-60A/Nasal/hdr.nas</file>
      <file>Aircraft/UH-60A/Nasal/light.nas</file>
      <file>Aircraft/UH-60A/Nasal/liveries.nas</file>
      <file>Aircraft/UH-60A/Nasal/uh60.nas</file>
      <file>Aircraft/UH-60A/Nasal/Electrical.nas</file>
      <file>Aircraft/UH-60A/Nasal/map.nas</file>
      <file>Aircraft/UH-60A/Nasal/dialogs.nas</file>
    </uh60>
    <PA>
      <file>Aircraft/UH-60A/Nasal/PA.nas</file>
    </PA>
    <radar>
      <file>Aircraft/UH-60A/Nasal/radar.nas</file>
    </radar>
    <terrain-map>
      <file>Aircraft/UH-60A/Nasal/terrain-map.nas</file>
    </terrain-map>
    <zkv1000>
      <file>Aircraft/UH-60A/Models/Interior/Panels/Instruments/zkv1000/zkv1000.nas</file>
    </zkv1000>

    aircraft.data.add(

    "instrumentation/nav[0]/audio-btn",
    "instrumentation/nav[0]/power-btn",
    "instrumentation/nav[0]/frequencies/selected-mhz",
    "instrumentation/nav[0]/frequencies/standby-mhz",
    "instrumentation/nav[0]/to-flag",
    "instrumentation/nav[0]/from-flag",
    "instrumentation/nav[0]/radials/selected-deg",
    "instrumentation/nav[0]/gs-needle-deflection",
    "instrumentation/nav[0]/heading-needle-deflection",
    "instrumentation/nav[0]/in-range",
    "instrumentation/comm[0]/volume",
    "instrumentation/comm[0]/frequencies/selected-mhz",
    "instrumentation/comm[0]/frequencies/standby-mhz",
    "instrumentation/comm[0]/test-btn",

    "instrumentation/nav[1]/power-btn",
    "instrumentation/nav[1]/audio-btn",
    "instrumentation/nav[1]/frequencies/selected-mhz",
    "instrumentation/nav[1]/frequencies/standby-mhz",
    "instrumentation/nav[1]/to-flag",
    "instrumentation/nav[1]/from-flag",
    "instrumentation/nav[1]/radials/selected-deg",
    "instrumentation/nav[1]/gs-needle-deflection",
    "instrumentation/nav[1]/heading-needle-deflection",
    "instrumentation/nav[1]/in-range",
    "instrumentation/comm[1]/volume",
    "instrumentation/comm[1]/frequencies/selected-mhz",
    "instrumentation/comm[1]/frequencies/standby-mhz",
    "instrumentation/comm[1]/test-btn",

    );

  </nasal>

</PropertyList>
