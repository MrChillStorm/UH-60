<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- One main rotor blade, written by fdm/rotorvis.py (see there); mainrotor.xml gives each
     instance its blade's properties in params -->

<PropertyList>

  <path>blade-rotor.ac</path>

  <params>
    <lag>rotors/main/blade[0]/lag-deg</lag>
    <flap>rotors/main/blade[0]/flap-deg</flap>
    <pitch>rotors/main/blade[0]/pitch-deg</pitch>
  </params>

  <!-- the fan fades in with the rpm; its shadow x 2: two wedges over each point -->
  <effect>
    <inherits-from>../../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <fade-from type="float"> 20 </fade-from>
      <fade-to type="float"> 160 </fade-to>
      <pbr-roughness type="float"> 1 </pbr-roughness>
      <shadow-gain type="float"> 2 </shadow-gain>
    </parameters>
    <object-name>blur0</object-name>
    <object-name>blur1</object-name>
    <object-name>blur2</object-name>
    <object-name>blur3</object-name>
    <object-name>blur4</object-name>
    <object-name>blur5</object-name>
    <object-name>blur6</object-name>
    <object-name>blur7</object-name>
    <object-name>blur8</object-name>
    <object-name>blur9</object-name>
    <object-name>blur10</object-name>
    <object-name>blur11</object-name>
    <object-name>blur12</object-name>
    <object-name>blur13</object-name>
    <object-name>blur14</object-name>
    <object-name>blur15</object-name>
    <object-name>blur16</object-name>
    <object-name>blur17</object-name>
    <object-name>blur18</object-name>
    <object-name>blur19</object-name>
    <object-name>blur20</object-name>
    <object-name>blur21</object-name>
    <object-name>blur22</object-name>
    <object-name>blur23</object-name>
  </effect>

  <!-- the blade fades out -->
  <effect>
    <inherits-from>../../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <fade-from type="float"> 160 </fade-from>
      <fade-to type="float"> 20 </fade-to>
      <pbr-roughness type="float"> 0.5 </pbr-roughness>
      <shadow-gain type="float"> 1 </shadow-gain>
    </parameters>
    <object-name>tblade1</object-name>
    <object-name>tblade2</object-name>
    <object-name>tblade3</object-name>
    <object-name>tblade4</object-name>
  </effect>

  <!-- the original's blur and disc: not shown -->
  <animation>
    <type>select</type>
    <object-name>propblur1</object-name>
    <object-name>propblur2</object-name>
    <object-name>propblur3</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propdisc3</object-name>
    <object-name>propdisc4</object-name>
    <condition>
      <property>sim/model/uh60/never</property>
    </condition>
  </animation>

  <!-- the opaque blade at low rpm -->
  <animation>
    <type>select</type>
    <object-name>blade1</object-name>
    <object-name>blade2</object-name>
    <object-name>blade3</object-name>
    <object-name>blade4</object-name>
    <condition>
      <less-than><property>rotors/main/rpm</property><value> 20 </value></less-than>
    </condition>
  </animation>

  <!-- then its fading copy -->
  <animation>
    <type>select</type>
    <object-name>tblade1</object-name>
    <object-name>tblade2</object-name>
    <object-name>tblade3</object-name>
    <object-name>tblade4</object-name>
    <condition>
      <and>
        <not><less-than><property>rotors/main/rpm</property><value> 20 </value></less-than></not>
        <less-than><property>rotors/main/rpm</property><value> 160 </value></less-than>
      </and>
    </condition>
  </animation>

  <!-- and the fan -->
  <animation>
    <type>select</type>
    <object-name>blur0</object-name>
    <object-name>blur1</object-name>
    <object-name>blur2</object-name>
    <object-name>blur3</object-name>
    <object-name>blur4</object-name>
