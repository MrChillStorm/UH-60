<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>collective.ac</path>

  <animation>
    <object-name>base</object-name>
    <object-name>collective</object-name>
    <object-name>hat</object-name>
    <object-name>button1</object-name>
    <object-name>toggle1</object-name>
    <object-name>toggle2</object-name>
    <object-name>toggle3</object-name>
    <object-name>switch1</object-name>
  </animation>

  <animation>
    <name>CollectiveComplet</name>
    <object-name>collective</object-name>
    <object-name>hat</object-name>
    <object-name>button1</object-name>
    <object-name>toggle1</object-name>
    <object-name>toggle2</object-name>
    <object-name>toggle3</object-name>
    <object-name>switch1</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>CollectiveComplet</object-name>
    <!-- the collective is the throttle axis, 1 = up (multiplay float[10] is the passenger door) -->
    <property>controls/engines/engine[0]/throttle</property>
    <factor> 20 </factor>
    <offset-deg> -20 </offset-deg>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
