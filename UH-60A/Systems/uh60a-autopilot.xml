    <input>
      <expression>
        <product>
          <property>/autopilot/uh60/gain/ped_coll</property>
          <property>/controls/engines/engine[0]/throttle</property>
        </product>
      </expression>
    </input>
    <output>/controls/flight/rudder</output>
  </filter>
  <filter>
    <name>flag: lateral cyclic on the wheels</name>
    <type>gain</type>
    <gain>1.0</gain>
    <input>
      <expression>
        <product>
          <property>/autopilot/uh60/engage</property>
          <property>/autopilot/uh60/axis-lat</property>
          <difference>
            <value>1.0</value>
            <property>/autopilot/uh60/internal/air</property>
          </difference>
        </product>
      </expression>
    </input>
    <output>/autopilot/uh60/internal/lat-ground</output>
  </filter>
  <filter>
    <name>lateral cyclic on the wheels</name>
    <enable>
      <condition>
        <and>
          <greater-than><property>/autopilot/uh60/internal/lat-ground</property><value>0.5</value></greater-than>
        </and>
      </condition>
    </enable>
    <type>noise-spike</type>
    <initialize-to>output</initialize-to>
    <max-rate-of-change>0.15</max-rate-of-change>
    <input>
      <expression>
        <product>
          <property>/autopilot/uh60/gain/lat_coll</property>
          <property>/controls/engines/engine[0]/throttle</property>
        </product>
      </expression>
    </input>
    <output>/controls/flight/aileron</output>
  </filter>
  <filter>
    <name>flag: longitudinal cyclic on the wheels</name>
    <type>gain</type>
    <gain>1.0</gain>
    <input>
      <expression>
        <product>
          <property>/autopilot/uh60/engage</property>
          <property>/autopilot/uh60/axis-lon</property>
          <difference>
            <value>1.0</value>
            <property>/autopilot/uh60/internal/air</property>
          </difference>
        </product>
      </expression>
    </input>
    <output>/autopilot/uh60/internal/lon-ground</output>
  </filter>
  <filter>
    <name>longitudinal cyclic on the wheels</name>
    <enable>
      <condition>
        <and>
          <greater-than><property>/autopilot/uh60/internal/lon-ground</property><value>0.5</value></greater-than>
        </and>
      </condition>
    </enable>
    <type>noise-spike</type>
    <initialize-to>output</initialize-to>
    <max-rate-of-change>0.15</max-rate-of-change>
    <input>
      <expression>
        <value>0.0</value>
      </expression>
    </input>
    <output>/controls/flight/elevator</output>
  </filter>
  <pid-controller>
    <name>pedals, cruise</name>
    <enable>
      <condition>
        <and>
          <greater-than><property>/autopilot/uh60/internal/yaw-cruise</property><value>0.5</value></greater-than>
        </and>
      </condition>
    </enable>
    <input>
      <expression>
        <property>/fdm/jsbsim/aero/beta-deg</property>
      </expression>
    </input>
    <reference>
      <expression>
        <property>/autopilot/uh60/target/beta-deg</property>
      </expression>
    </reference>
    <config>
      <Kp>/autopilot/uh60/gain/b_kp</Kp>
      <beta>1.0</beta>
      <alpha>0.1</alpha>
      <gamma>0.0</gamma>
      <Ti>/autopilot/uh60/gain/b_ti</Ti>
      <Td>0.0</Td>
      <u_min>-1.0</u_min>
      <u_max>1.0</u_max>
    </config>
    <output>/controls/flight/rudder</output>
  </pid-controller>
  <filter>
    <name>FPS off while flying the cyclic or pedals</name>
    <enable>
      <condition>
        <and>
          <greater-than><property>/autopilot/uh60/internal/fps-hold</property><value>0.5</value></greater-than>
        </and>
      </condition>
    </enable>
    <type>gain</type>
    <gain>1.0</gain>
    <input>
      <expression>
        <value>0.0</value>
      </expression>
    </input>
    <output>/fdm/jsbsim/ctl/fps</output>
  </filter>
  <filter>
    <name>update interval: average</name>
    <type>moving-average</type>
    <samples>2</samples>
    <input>/fdm/jsbsim/simulation/sim-time-sec</input>
    <output>/autopilot/uh60/internal/time-avg</output>
  </filter>
  <filter>
    <name>update interval</name>
    <type>gain</type>
    <gain>2.0</gain>
    <input>
      <expression>
        <difference>
          <property>/fdm/jsbsim/simulation/sim-time-sec</property>
          <property>/autopilot/uh60/internal/time-avg</property>
        </difference>
      </expression>
    </input>
    <output>/autopilot/uh60/internal/update-s</output>
  </filter>
</PropertyList>
