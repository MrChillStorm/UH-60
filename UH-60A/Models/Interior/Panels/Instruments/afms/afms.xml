<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- written by fdm/cockpit/instruments.py -->

<!-- auxiliary fuel management panel (no external tanks are simulated) -->
<PropertyList>

  <path>afms.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>panel</object-name>
    <object-name>toggles</object-name>
    <object-name>knobs</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>panel</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

</PropertyList>
