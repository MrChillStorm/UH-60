<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- thanks to the SAR simulation (GPL) for the helicopter sounds,
     and the Urban game (LGPL) for the weapon sounds

     +x = aft
     +y = left
     +z = up
-->
<PropertyList>

  <fx>

    <!-- Starting Engines -->
    <starter>
      <name>starter0_start</name>
      <path>uh60_full_startup_sequence.wav</path>
      <mode>once</mode>
      <condition>
        <greater-than>
          <!-- <property>sim/model/uh60/state</property> -->
          <property>sim/multiplay/generic/int[6]</property>
          <value>0</value>
        </greater-than>
      </condition>
      <volume>
        <factor>1</factor>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </starter>

    <engine>
      <name>turbine1-loop</name>
      <path>uh60_turbine_loop.wav</path>
      <mode>looped</mode>
      <condition>
        <and>
          <greater-than>
            <!-- <property>sim/model/uh60/state</property> -->
            <property>sim/multiplay/generic/int[6]</property>
            <value>1</value>
          </greater-than>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <!-- <not><property>sim/crashed</property></not> -->
          <not><property>sim/multiplay/generic/bool[6]</property></not>
        </and>
      </condition>
      <volume>
        <!-- <property>rotors/gear/torque-sound-filtered</property> -->
        <property>sim/multiplay/generic/float[19]</property>
        <factor>0.3</factor>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.003125</factor>
        <offset>-0.0</offset>
        <max>1.03</max>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </engine>

    <shockfront>
      <name>shockfront</name>
      <path>uh60_idle_outside_vortexinteraction_loop.wav</path>
      <mode>looped</mode>
      <condition>
        <and>
          <greater-than>
            <property>rotors/main/rpm</property>
            <value>50</value>
          </greater-than>
          <!-- <not><property>sim/crashed</property></not> -->
          <not><property>sim/multiplay/generic/bool[6]</property></not>
        </and>
      </condition>
      <volume>
        <!-- <property>rotors/gear/torque-sound-filtered</property> -->
        <property>sim/multiplay/generic/float[19]</property>
        <factor>0.75</factor>
      </volume>
      <pitch>
        <property>rotors/main/rpm</property>
        <factor>0.0006</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <position>
        <x> 0 </x>
        <y> 0 </y>
        <z> 0 </z>
      </position>
      <orientation>
        <x> -1 </x>
        <y>  0 </y>
        <z>  0 </z>
        <inner-angle>30.0</inner-angle>
        <outer-angle>90.0</outer-angle>
        <outer-gain>0.1</outer-gain>
      </orientation>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </shockfront>

    <rotor>
      <name>rotor-outside</name>
      <path>uh60_idle_outside_loop.wav</path>
      <mode>looped</mode>
      <condition>
        <and>
          <greater-than>
            <property>rotors/tail/rpm</property>
            <value>50</value>
          </greater-than>
          <!-- <not><property>sim/crashed</property></not> -->
          <not><property>sim/multiplay/generic/bool[6]</property></not>
        </and>
      </condition>
      <volume>
        <!-- <property>rotors/gear/torque-sound-filtered</property> -->
        <property>sim/multiplay/generic/float[19]</property>
        <factor>0.75</factor>
      </volume>
      <pitch>
        <property>rotors/tail/rpm</property>
        <factor>0.0006</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rotor>

    <rotor>
      <name>blade-vortex-interaction</name>
      <path>blade_vortex.wav</path>
      <mode>looped</mode>
      <condition>
        <and>
          <greater-than>
            <property>rotors/tail/rpm</property>
            <value>50</value>
          </greater-than>
          <!-- <not><property>sim/crashed</property></not> -->
          <not><property>sim/multiplay/generic/bool[6]</property></not>
        </and>
      </condition>
      <volume>
        <!-- <property>rotors/gear/torque-sound-filtered</property> -->
        <property>sim/multiplay/generic/float[19]</property>
        <factor>0.75</factor>
      </volume>
      <pitch>
        <property>rotors/tail/rpm</property>
        <factor>0.0006</factor>
        <offset>-0.0</offset>
        <max>2.5</max>
      </pitch>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </rotor>

    <!-- **************************************************** -->
    <!-- Doors sounds -->
    <door>
