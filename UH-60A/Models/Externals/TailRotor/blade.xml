  <effect>
    <inherits-from>../../Effects/RotorBlur/rotor-blur</inherits-from>
    <parameters>
      <rotor-rpm type="float"><use>/rotors/tail/rpm</use></rotor-rpm>
      <fade-from type="float"> 737.984 </fade-from>
      <fade-to type="float"> 92.2481 </fade-to>
      <pbr-roughness type="float"> 0.5 </pbr-roughness>
      <shadow-gain type="float"> 1 </shadow-gain>
    </parameters>
    <object-name>tblade</object-name>
  </effect>

  <!-- the original's blur and disc: not shown -->
  <animation>
    <type>select</type>
    <object-name>propblur</object-name>
    <object-name>propdisc</object-name>
    <condition>
      <property>sim/model/uh60/never</property>
    </condition>
  </animation>

  <!-- the opaque blade at low rpm -->
  <animation>
    <type>select</type>
    <object-name>blade</object-name>
    <condition>
      <less-than><property>rotors/tail/rpm</property><value> 92.2481 </value></less-than>
    </condition>
  </animation>

  <!-- then its fading copy -->
  <animation>
    <type>select</type>
    <object-name>tblade</object-name>
    <condition>
      <and>
        <not><less-than><property>rotors/tail/rpm</property><value> 92.2481 </value></less-than></not>
        <less-than><property>rotors/tail/rpm</property><value> 737.984 </value></less-than>
      </and>
    </condition>
  </animation>

