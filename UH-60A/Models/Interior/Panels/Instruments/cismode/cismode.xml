<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- written by fdm/cockpit/instruments.py -->

<!-- CIS mode selector (Nasal/avionics.nas) -->
<PropertyList>

  <path>cismode.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>panel</object-name>
    <object-name>frames</object-name>
    <object-name>btn-hdg</object-name>
    <object-name>lit-hdg</object-name>
    <object-name>btn-nav</object-name>
    <object-name>lit-nav</object-name>
    <object-name>btn-alt</object-name>
    <object-name>lit-alt</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>panel</object-name>
    <object-name>frames</object-name>
    <emission>
      <factor-prop>/instrumentation/uh60/lights/non-flt</factor-prop>
      <red>   0.10 </red>
      <green> 1.00 </green>
      <blue>  0.45 </blue>
    </emission>
  </animation>

  <effect>
    <inherits-from>../../../../Effects/Lit/lit</inherits-from>
    <parameters>
      <lit-color type="vec3d"> 0.10 1.00 0.45 </lit-color>
      <lit-level type="float"><use>/instrumentation/uh60/lights/non-flt</use></lit-level>
      <lit-gain type="float"> 1.91 </lit-gain>
      <lit-reflectance type="float"> 1 </lit-reflectance>
    </parameters>
    <object-name>panel</object-name>
    <object-name>frames</object-name>
  </effect>

  <animation>
    <type>select</type>
    <object-name>lit-hdg</object-name>
    <condition>
      <property>/controls/electric/battery-switch</property><property>/instrumentation/uh60/cis/hdg-on</property>
    </condition>
  </animation>

  <animation>
    <type>material</type>
    <object-name>lit-hdg</object-name>
    <emission>
      <factor-prop>/instrumentation/uh60/lights/switches</factor-prop>
      <red> 1 </red>
      <green> 1 </green>
      <blue> 1 </blue>
    </emission>
  </animation>

  <effect>
    <inherits-from>../../../../Effects/Lit/lit</inherits-from>
    <parameters>
      <lit-color type="vec3d"> 1.00 1.00 1.00 </lit-color>
      <lit-level type="float"><use>/instrumentation/uh60/lights/hdr/switches</use></lit-level>
      <lit-gain type="float"> 1 </lit-gain>
      <lit-reflectance type="float"> 0.05 </lit-reflectance>
    </parameters>
    <object-name>lit-hdg</object-name>
  </effect>

  <animation>
    <type>translate</type>
    <object-name>btn-hdg</object-name>
    <object-name>lit-hdg</object-name>
    <property>/instrumentation/uh60/cis/press-hdg</property>
    <factor> -0.0012 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>btn-hdg</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>setprop("/instrumentation/uh60/cis/press-hdg", 1); avionics.press("hdg")</script>
      </binding>
      <mod-up>
        <binding>
          <command>nasal</command>
          <script>setprop("/instrumentation/uh60/cis/press-hdg", 0)</script>
        </binding>
      </mod-up>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>btn-hdg</tooltip-id>
        <label>CIS mode: HDG</label>
      </binding>
    </hovered>
  </animation>

  <animation>
    <type>select</type>
    <object-name>lit-nav</object-name>
    <condition>
      <property>/controls/electric/battery-switch</property><property>/instrumentation/uh60/cis/nav-on</property>
    </condition>
  </animation>

  <animation>
