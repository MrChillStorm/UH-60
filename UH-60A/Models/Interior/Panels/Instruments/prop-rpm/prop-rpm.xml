<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>prop-rpm.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>rpm1</object-name>
    <object-name>rpm2</object-name>
    <object-name>rpmR</object-name>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <object-name>digit10R</object-name>
    <object-name>digit1R</object-name>
    <object-name>digit10L</object-name>
    <object-name>digit1L</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpm1</object-name>
    <property>rotors/main/rpm</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> 0.000 </dep></entry>
      <entry><ind> 250 </ind><dep> 0.050 </dep></entry>
      <entry><ind> 350 </ind><dep> 0.140 </dep></entry>
      <entry><ind> 450 </ind><dep> 0.225 </dep></entry>
      <entry><ind> 475 </ind><dep> 0.310 </dep></entry>
      <entry><ind> 500 </ind><dep> 0.400 </dep></entry>
      <entry><ind> 525 </ind><dep> 0.490 </dep></entry>
      <entry><ind> 550 </ind><dep> 0.580 </dep></entry>
      <entry><ind> 600 </ind><dep> 0.670 </dep></entry>
      <entry><ind> 650 </ind><dep> 0.740 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpm2</object-name>
    <property>rotors/main/rpm</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> 0.000 </dep></entry>
      <entry><ind> 250 </ind><dep> 0.050 </dep></entry>
      <entry><ind> 350 </ind><dep> 0.140 </dep></entry>
      <entry><ind> 450 </ind><dep> 0.225 </dep></entry>
      <entry><ind> 475 </ind><dep> 0.310 </dep></entry>
      <entry><ind> 500 </ind><dep> 0.400 </dep></entry>
      <entry><ind> 525 </ind><dep> 0.490 </dep></entry>
      <entry><ind> 550 </ind><dep> 0.580 </dep></entry>
      <entry><ind> 600 </ind><dep> 0.670 </dep></entry>
      <entry><ind> 650 </ind><dep> 0.740 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>rpmR</object-name>
    <property>rotors/main/rpm</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> 0.000 </dep></entry>
      <entry><ind> 250 </ind><dep> 0.050 </dep></entry>
      <entry><ind> 350 </ind><dep> 0.140 </dep></entry>
      <entry><ind> 450 </ind><dep> 0.225 </dep></entry>
      <entry><ind> 475 </ind><dep> 0.310 </dep></entry>
      <entry><ind> 500 </ind><dep> 0.400 </dep></entry>
      <entry><ind> 525 </ind><dep> 0.490 </dep></entry>
      <entry><ind> 550 </ind><dep> 0.580 </dep></entry>
      <entry><ind> 600 </ind><dep> 0.670 </dep></entry>
      <entry><ind> 650 </ind><dep> 0.740 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>trq1</object-name>
    <object-name>trq2</object-name>
    <property>rotors/gear/total-torque</property>
    <interpolation>
      <entry><ind>       0 </ind><dep> 0.000 </dep></entry>
      <entry><ind>  250000 </ind><dep> 0.040 </dep></entry>
      <entry><ind>  400000 </ind><dep> 0.075 </dep></entry>
      <entry><ind>  600000 </ind><dep> 0.109 </dep></entry>
      <entry><ind>  800000 </ind><dep> 0.143 </dep></entry>
      <entry><ind> 1000000 </ind><dep> 0.178 </dep></entry>
      <entry><ind> 1200000 </ind><dep> 0.217 </dep></entry>
      <entry><ind> 1400000 </ind><dep> 0.240 </dep></entry>
    </interpolation>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- DIGIT -->
  <animation>
    <type>textranslate</type>
    <object-name>digit10L</object-name>
    <property>rotors/gear/total-torque</property>
    <factor>0.000001</factor>
    <step>100000</step>
    <min>0</min>
    <bias></bias>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit1L</object-name>
    <property>rotors/gear/total-torque</property>
    <factor>0.00001</factor>
    <step>10000</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit10R</object-name>
    <property>rotors/gear/total-torque</property>
    <factor>0.000001</factor>
    <step>100000</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>textranslate</type>
    <object-name>digit1R</object-name>
    <property>rotors/gear/total-torque</property>
    <factor>0.00001</factor>
    <step>10000</step>
    <min>0</min>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
