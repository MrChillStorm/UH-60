      <entry><ind> 0.1 </ind><dep> -135 </dep></entry>
      <entry><ind> 1 </ind><dep> 135 </dep></entry>
    </interpolation>
    <center>
      <x-m> 0.0015 </x-m>
      <y-m> 0.0000 </y-m>
      <z-m> 0.0000 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>knob-radalt-norm</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>avionics.step("/controls/lighting/radalt-norm", 0.1, 0.1, 1)</script>
