  <animation>
    <type>noshadow</type>
    <object-name>panel</object-name>
    <object-name>knob-radalt-norm</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>panel</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
