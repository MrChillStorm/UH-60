<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>ai.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>AttitudeBall</object-name>
    <object-name>barre</object-name>
    <object-name>barre1</object-name>
    <object-name>barre2</object-name>
    <object-name>SkyPointer</object-name>
    <object-name>bouton</object-name>
    <object-name>ai-ring</object-name>
    <object-name>nav-pitch-steering-ba</object-name>
    <object-name>nav-yaw-steering-bar</object-name>
    <object-name>gs-scale</object-name>
    <object-name>ils-flags</object-name>
    <object-name>course-flag</object-name>
    <object-name>ring-slip</object-name>
    <object-name>slip-ball</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>AttitudeBall</object-name>
    <object-name>barre</object-name>
    <object-name>barre1</object-name>
    <object-name>barre2</object-name>
    <object-name>SkyPointer</object-name>
    <object-name>bouton</object-name>
    <object-name>ai-ring</object-name>
    <object-name>nav-pitch-steering-ba</object-name>
    <object-name>nav-yaw-steering-bar</object-name>
    <object-name>gs-scale</object-name>
    <object-name>ils-flags</object-name>
    <object-name>course-flag</object-name>
    <object-name>ring-slip</object-name>
    <object-name>slip-ball</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../../../../Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>AttitudeBall</object-name>
    <object-name>SkyPointer</object-name>
    <object-name>slip-ball</object-name>
    <object-name>ils-flag</object-name>
    <object-name>course-flag</object-name>
    <object-name>barre</object-name>
    <object-name>barre1</object-name>
    <object-name>barre2</object-name>
    <object-name>nav-pitch-steering-ba</object-name>
    <object-name>nav-yaw-steering-bar</object-name>
    <object-name>ring-slip</object-name>
    <object-name>ai-ring</object-name>
    <object-name>gs-scale</object-name>
    <emission>
      <factor-prop>/instrumentation/uh60/lights/cplt-flt</factor-prop>
      <red>   0.10 </red>
      <green> 1.00 </green>
      <blue>  0.45 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>AttitudeBall</object-name>
    <property>orientation/roll-deg</property>
    <factor>1</factor>
    <center>
      <x-m> -0.056 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>AttitudeBall</object-name>
    <property>orientation/pitch-deg</property>
    <factor>1</factor>
    <center>
      <x-m> -0.056 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>SkyPointer</object-name>
    <property>orientation/roll-deg</property>
    <factor>1</factor>
    <center>
      <x-m> -0.056 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>slip-ball</object-name>
    <property>instrumentation/slip-skid-ball/indicated-slip-skid</property>
    <factor>8</factor>
    <min-deg> -13 </min-deg>
    <max-deg>  13 </max-deg>
    <center>
      <x-m> -0.056 </x-m>
      <y-m>  0.000 </y-m>
      <z-m>  0.000 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- CIS: written by fdm/cockpit/avionics.py -->
  <model>
    <path>cis-copilot.xml</path>
  </model>

  <animation>
    <type>translate</type>
    <object-name>nav-pitch-steering-ba</object-name>
    <property>/instrumentation/uh60/cis/roll-cmd</property>
    <factor> 0.025 </factor>
    <min> -0.025 </min>
    <max> 0.025 </max>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>nav-pitch-steering-ba</object-name>
    <condition>
      <property>/instrumentation/uh60/cis/roll-vis</property>
    </condition>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>nav-yaw-steering-bar</object-name>
    <property>/instrumentation/uh60/cis/pitch-cmd</property>
    <factor> 0.025 </factor>
    <min> -0.025 </min>
    <max> 0.025 </max>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>nav-yaw-steering-bar</object-name>
    <condition>
      <property>/instrumentation/uh60/cis/pitch-vis</property>
    </condition>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>ils-flag</object-name>
    <property>/instrumentation/uh60/cis/coll-cmd</property>
    <factor> 0.02 </factor>
    <min> -0.02 </min>
    <max> 0.02 </max>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <type>select</type>
    <object-name>ils-flag</object-name>
    <condition>
      <property>/instrumentation/uh60/cis/coll-vis</property>
    </condition>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>vitre</object-name>
    <property>constants/zero</property>
    <offset-m> 0.0080 </offset-m>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>
  <!-- /CIS -->

</PropertyList>
