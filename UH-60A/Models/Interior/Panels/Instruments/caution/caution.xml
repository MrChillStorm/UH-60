<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- Master warning panel, TM 1-1520-237-10 2.81 and figure 2-23, with the flight model's values. The lights need dc
     power (battery switch) and all light in the caution/advisory panel's lamp test. Written by fdm/cockpit/cap.py. -->

<PropertyList>

  <path>caution.ac</path>

  <animation>
    <type>noshadow</type>
    <object-name>panel</object-name>
    <object-name>capsules</object-name>
    <object-name>lit-eng-out-1</object-name>
    <object-name>lit-eng-out-2</object-name>
    <object-name>lit-fire</object-name>
    <object-name>btn-master</object-name>
    <object-name>lit-master</object-name>
    <object-name>lit-low-rpm</object-name>
  </animation>

  <animation>
    <type>material</type>
    <object-name>lit-eng-out-1</object-name>
    <object-name>lit-eng-out-2</object-name>
    <object-name>lit-fire</object-name>
    <object-name>lit-master</object-name>
    <object-name>lit-low-rpm</object-name>
    <emission>
      <factor-prop>/instrumentation/uh60/lights/ma-wrn</factor-prop>
      <red> 1 </red>
      <green> 1 </green>
      <blue> 1 </blue>
    </emission>
  </animation>

  <effect>
    <inherits-from>../../../../Effects/Lit/lit</inherits-from>
    <parameters>
      <lit-color type="vec3d"> 1.00 1.00 1.00 </lit-color>
      <lit-level type="float"><use>/instrumentation/uh60/lights/hdr/ma-wrn</use></lit-level>
      <lit-gain type="float"> 1 </lit-gain>
    </parameters>
    <object-name>lit-eng-out-1</object-name>
    <object-name>lit-eng-out-2</object-name>
    <object-name>lit-fire</object-name>
    <object-name>lit-master</object-name>
    <object-name>lit-low-rpm</object-name>
  </effect>

  <!-- #1 ENG OUT: gas generator speed Ng below 55 % -->
  <animation>
    <type>select</type>
    <object-name>lit-eng-out-1</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
      <or>
        <property>sim/model/uh60/cap-test</property>
        <less-than><property>engines/engine[0]/n1-pct</property><value>55</value></less-than>
      </or>
    </condition>
  </animation>

  <!-- #2 ENG OUT: gas generator speed Ng below 55 % -->
  <animation>
    <type>select</type>
    <object-name>lit-eng-out-2</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
      <or>
        <property>sim/model/uh60/cap-test</property>
        <less-than><property>engines/engine[1]/n1-pct</property><value>55</value></less-than>
      </or>
    </condition>
  </animation>

  <!-- FIRE: no fire is simulated; the lamp test only -->
  <animation>
    <type>select</type>
    <object-name>lit-fire</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
      <or>
        <property>sim/model/uh60/cap-test</property>
        <property>sim/model/uh60/cap-test</property>
      </or>
    </condition>
  </animation>

  <!-- MASTER CAUTION: an amber capsule of the caution/advisory panel has lit (Nasal/caution.nas) -->
  <animation>
    <type>select</type>
    <object-name>lit-master</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
      <or>
        <property>sim/model/uh60/cap-test</property>
        <property>sim/model/uh60/master-caution</property>
      </or>
    </condition>
  </animation>

  <!-- LOW ROTOR RPM: rotor speed below 96 %, flashing -->
  <animation>
    <type>select</type>
    <object-name>lit-low-rpm</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
      <property>sim/model/uh60/warning-flash</property>
      <or>
        <property>sim/model/uh60/cap-test</property>
        <less-than><property>rotors/main/rpm-pct</property><value>96</value></less-than>
      </or>
    </condition>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>btn-master</object-name>
    <object-name>lit-master</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>caution.reset()</script>
      </binding>
    </action>
    <hovered>
      <binding>
        <command>set-tooltip</command>
        <tooltip-id>uh60-master-caution</tooltip-id>
        <label>Master caution: press to reset</label>
      </binding>
    </hovered>
  </animation>

</PropertyList>
