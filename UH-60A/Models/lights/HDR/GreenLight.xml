<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <light>
    <name>navlightgreen</name>
    <!-- HDR: a spot aimed out through its lens, so that it lights the night around it and not its own skin;
         intensity in candela, converted with the sun (fdm/cockpit/instruments.py, HDR_CD), falling off as cos^3
         away from the horizontal: the ground below gets a little -->
    <type>spot</type>
    <direction>
      <lookat-x-m> 0 </lookat-x-m>
      <lookat-y-m> 1 </lookat-y-m>
      <lookat-z-m> 0 </lookat-z-m>
    </direction>
    <color>
      <r> 0.15 </r>
      <g> 1 </g>
      <b> 0.45 </b>
    </color>
    <intensity>
      <property>/instrumentation/uh60/lights/hdr/unit-per-cd</property>
      <scale> 40 </scale>                     <!-- cd -->
    </intensity>
    <spot-exponent> 3 </spot-exponent>
    <spot-cutoff> 70 </spot-cutoff>
    <range-m> 20 </range-m>
  </light>

  <animation>
    <type>noshadow</type>
    <object-name>navlightgreen</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>navlightgreen</object-name>
    <condition>
      <!-- <property>controls/lighting/nav-lights</property> -->
      <property>sim/multiplay/generic/bool[15]</property>
    </condition>
  </animation>

</PropertyList>
