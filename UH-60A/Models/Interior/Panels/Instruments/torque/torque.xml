<?xml version="1.0" encoding="ISO-8859-1"?>

<!-- dual torque indicator: left needle No. 1 engine, right needle No. 2; the inner scale reads torque / 100 % -->
<PropertyList>

  <path>torque.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>Lneedle</object-name>
    <object-name>Rneedle</object-name>

    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>Lneedle</object-name>
    <object-name>Rneedle</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../../../../Effects/Glass/instrument-glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>Lneedle</object-name>
    <object-name>Rneedle</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Lneedle</object-name>
    <property>engines/engine[0]/torque-pct</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> -205 </dep></entry>
      <entry><ind>  40 </ind><dep> -148 </dep></entry>
      <entry><ind>  50 </ind><dep> -128 </dep></entry>
      <entry><ind>  60 </ind><dep> -104 </dep></entry>
      <entry><ind>  70 </ind><dep>  -81 </dep></entry>
      <entry><ind>  80 </ind><dep>  -50 </dep></entry>
      <entry><ind>  90 </ind><dep>  -25 </dep></entry>
      <entry><ind> 100 </ind><dep>    2 </dep></entry>
      <entry><ind> 120 </ind><dep>   52 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Rneedle</object-name>
    <property>engines/engine[1]/torque-pct</property>
    <interpolation>
      <entry><ind>   0 </ind><dep> -205 </dep></entry>
      <entry><ind>  40 </ind><dep> -148 </dep></entry>
      <entry><ind>  50 </ind><dep> -128 </dep></entry>
      <entry><ind>  60 </ind><dep> -104 </dep></entry>
      <entry><ind>  70 </ind><dep>  -81 </dep></entry>
      <entry><ind>  80 </ind><dep>  -50 </dep></entry>
      <entry><ind>  90 </ind><dep>  -25 </dep></entry>
      <entry><ind> 100 </ind><dep>    2 </dep></entry>
      <entry><ind> 120 </ind><dep>   52 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
